rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /chats/{cid} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      match /messages/{mid} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      }
    }
  }
}
